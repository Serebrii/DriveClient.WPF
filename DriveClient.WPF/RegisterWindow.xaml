<Window x:Class="DriveClient.WPF.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація | Віртуальний диск" Height="320" Width="400"
        WindowStartupLocation="CenterScreen">
	<Grid Margin="20">
		<StackPanel VerticalAlignment="Center">
			<TextBlock Text="Реєстрація нового користувача" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

			<TextBlock Text="Логін:" Margin="0,5,0,2"/>
			<TextBox x:Name="txtUsername" Height="25"/>

			<TextBlock Text="Пароль:" Margin="0,10,0,2"/>
			<PasswordBox x:Name="txtPassword" Height="25"/>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
				<Button Content="Зареєструватися" Click="RegisterButton_Click" Width="130" Height="30" Margin="5"/>
				<Button Content="Скасувати" Click="CancelButton_Click" Width="90" Height="30" Margin="5"/>
			</StackPanel>
		</StackPanel>
	</Grid>
</Window>