<Window x:Class="DriveClientWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Віртуальний диск" Height="500" Width="850"
        WindowStartupLocation="CenterScreen">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
			<TextBlock x:Name="txtUserInfo" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
			<Button Content="Вийти" Click="Logout_Click" Margin="0,0,15,0" Padding="8,3" Background="#FFF8D7D7"/>

			<Button Content="Завантажити" Click="Upload_Click" Margin="5,0" Padding="8,3"/>
			<Button Content="Вивантажити" Click="Download_Click" Margin="5,0" Padding="8,3"/>
			<Button Content="Видалити" Click="Delete_Click" Margin="5,0" Padding="8,3"/>
			<Button Content="Синхронізувати папку" Click="Sync_Click" Margin="5,0" Padding="8,3"/>
		</StackPanel>

		<GroupBox Grid.Row="1" Header="Параметри відображення" Margin="0,0,0,10" Padding="10">
			<StackPanel>
				<WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
					<TextBlock Text="Фільтр:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>
					<ComboBox x:Name="cmbFilter" Width="130" SelectionChanged="FilterOrSort_Changed" Margin="0,0,20,0">
						<ComboBoxItem x:Name="cbiAllFiles" Content="Всі файли" IsSelected="True"/>
						<ComboBoxItem Content=".cpp"/>
						<ComboBoxItem Content=".png"/>
					</ComboBox>

					<TextBlock Text="Сортування:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>
					<ComboBox x:Name="cmbSort" Width="200" SelectionChanged="FilterOrSort_Changed" Margin="0,0,20,0">
						<ComboBoxItem x:Name="cbiSortDesc" Content="Спочатку нові (спадання)" IsSelected="True"/>
						<ComboBoxItem Content="Спочатку старі (зростання)"/>
					</ComboBox>

					<Button Content="Скинути фільтри" Click="ResetFilters_Click" Padding="10,3" Cursor="Hand" Background="#F0F0F0"/>
				</WrapPanel>

				<Separator Margin="0,0,0,10"/>

				<WrapPanel VerticalAlignment="Center">
					<TextBlock Text="Відображати стовпці:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>

					<CheckBox x:Name="chkSize" Content="Розмір" IsChecked="True" Click="ToggleColumn_Click" Margin="0,0,15,0" VerticalAlignment="Center"/>
					<CheckBox x:Name="chkCreated" Content="Дата створення" IsChecked="True" Click="ToggleColumn_Click" Margin="0,0,15,0" VerticalAlignment="Center"/>
					<CheckBox x:Name="chkUpdated" Content="Дата зміни" IsChecked="True" Click="ToggleColumn_Click" Margin="0,0,15,0" VerticalAlignment="Center"/>
					<CheckBox x:Name="chkUploader" Content="Хто завантажив" IsChecked="True" Click="ToggleColumn_Click" Margin="0,0,15,0" VerticalAlignment="Center"/>
					<CheckBox x:Name="chkEditor" Content="Хто редагував" IsChecked="True" Click="ToggleColumn_Click" Margin="0,0,15,0" VerticalAlignment="Center"/>
				</WrapPanel>
			</StackPanel>
		</GroupBox>

		<DataGrid x:Name="FilesDataGrid" 
          Grid.Row="2" 
          AutoGenerateColumns="False" 
          IsReadOnly="True" 
          GridLinesVisibility="Horizontal"
          AllowDrop="True"
          Drop="FilesDataGrid_Drop"
          DragOver="FilesDataGrid_DragOver"
          MouseDoubleClick="FilesDataGrid_MouseDoubleClick">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Назва файлу" Binding="{Binding Name}" Width="*"/>
				<DataGridTextColumn Header="Розмір" Binding="{Binding Size}"/>
				<DataGridTextColumn Header="Дата створення" Binding="{Binding CreatedAtLocal, StringFormat=\{0:dd.MM.yyyy HH:mm\}}"/>
				<DataGridTextColumn Header="Дата зміни" Binding="{Binding UpdatedAtLocal, StringFormat=\{0:dd.MM.yyyy HH:mm\}}"/>
				<DataGridTextColumn Header="Хто завантажив" Binding="{Binding UploadedBy}"/>
				<DataGridTextColumn Header="Хто редагував" Binding="{Binding EditedBy}"/>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</Window>