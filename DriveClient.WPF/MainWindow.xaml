<Window x:Class="DriveClient.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Drive (WPF)" Height="600" Width="900"
        AllowDrop="True" Drop="Window_Drop">
	<!-- Увімкнення Drag-n-Drop -->

	<Grid Margin="10">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="2*"/>
			<ColumnDefinition Width="1*"/>
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Панель керування -->
		<StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
			<Button Content="Завантажити (Upload)" Width="130" Margin="0,0,10,0" Click="UploadButton_Click"/>
			<Button Content="Синхронізувати" Width="100" Margin="0,0,10,0"/>

			<ComboBox x:Name="FilterCombo" Width="100" Margin="20,0,10,0" SelectedIndex="0" SelectionChanged="FilterOrSortChanged">
				<ComboBoxItem Content="Всі файли" Tag=""/>
				<ComboBoxItem Content="Тільки .cpp" Tag=".cpp"/>
				<ComboBoxItem Content="Тільки .png" Tag=".png"/>
			</ComboBox>

			<ComboBox x:Name="SortCombo" Width="180" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="FilterOrSortChanged">
				<ComboBoxItem Content="За датою зміни (зростання)"/>
				<ComboBoxItem Content="За датою зміни (спадання)"/>
			</ComboBox>
		</StackPanel>

		<!-- Таблиця файлів -->
		<DataGrid x:Name="FilesGrid" Grid.Row="1" Grid.Column="0" AutoGenerateColumns="False" 
                  IsReadOnly="True" Margin="0,0,10,0" SelectionChanged="FilesGrid_SelectionChanged">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*"/>
				<DataGridTextColumn Header="Розширення" Binding="{Binding Extension}"/>
				<DataGridTextColumn Header="Дата зміни" Binding="{Binding ModificationDate, StringFormat=dd.MM.yyyy HH:mm}"/>
				<DataGridTextColumn Header="Автор" Binding="{Binding UploadedBy}"/>
			</DataGrid.Columns>
		</DataGrid>

		<!-- Зона перегляду файлу кліком (.cpp або .png) -->
		<GroupBox Grid.Row="1" Grid.Column="1" Header="Попередній перегляд">
			<Grid>
				<Image x:Name="PreviewImage" Visibility="Collapsed" Margin="5"/>
				<TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="5"/>
			</Grid>
		</GroupBox>
	</Grid>
</Window>