<Window x:Class="DriveClient.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизація | Віртуальний диск" Height="320" Width="400"
        WindowStartupLocation="CenterScreen">
	<Grid Margin="20">
		<StackPanel VerticalAlignment="Center">
			<TextBlock Text="Вхід у віртуальний диск" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

			<TextBlock Text="Логін:" Margin="0,5,0,2"/>
			<TextBox x:Name="txtUsername" Height="25"/>

			<TextBlock Text="Пароль:" Margin="0,10,0,2"/>
			<PasswordBox x:Name="txtPassword" Height="25"/>

			<Button Content="Увійти" Click="LoginButton_Click" Height="30" Margin="0,20,0,10"/>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
				<TextBlock Text="Немає акаунту? " VerticalAlignment="Center"/>
				<Button Content="Зареєструватися" Click="OpenRegister_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="Blue" Cursor="Hand"/>
			</StackPanel>
		</StackPanel>
	</Grid>
</Window>